[Script]
移除扫码取件页面商品推荐及弹窗 = type=http-response, pattern=(?i)^https:\/\/m\.pinduoduo\.net(?::443)?\/mdkd\/package\/?\?(?:[^#?&]+&)*from_app_scan(?:=[^&#]*)?(?:&[^#]*)?$, script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/adblock/pinduoduo.js?v=caf9144e5680, requires-body=true,max-size=2097152,timeout=5

[MITM]
hostname = %APPEND% api.pinduoduo.com, m.pinduoduo.net
