#!name=Telegram重定向
#!desc=用于在指定客户端中打开公开或私有群组及频道的Telegram短链。
#!category=功能
#!arguments=app:tg
#!arguments-desc=客户端 Scheme，可选值：tg, sg, turrit, ime, ng, lingo, rg

[Script]
tg-redirect = type=http-request,pattern=^https?:\/\/t\.me\/,script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/telegram302.js,requires-body=0,max-size=0,argument={app}

[MITM]
hostname = %APPEND% t.me
