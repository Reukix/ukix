#!name=YouTube Music
#!desc=移除播放广告和底栏升级入口，启用后台播放，适用于 iOS YouTube Music。
#!category=去广告
#!date=2026-11-18
#!version=2026.11.18.2

[Script]
ytmusic-init=type=http-request,pattern=^https:\/\/[\w-]+\.googlevideo\.com(?::443)?\/initplayback\?,script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/YouTubeMusic.js?v=b3d79b662087,timeout=3
ytmusic-player=type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com(?::443)?\/youtubei\/v1\/(?:player|next|get_watch|guide)(?:\?|$),requires-body=true,binary-body-mode=true,max-size=4194304,script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/YouTubeMusic.js?v=b3d79b662087,timeout=5

[MITM]
hostname=%APPEND% youtubei.googleapis.com,*.googlevideo.com
