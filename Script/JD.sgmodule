#!name=京东去广告
#!desc=兼容 URL 参数与 POST 路由、明文和 base64 响应，过滤开屏配置和推广楼层；正常业务响应原样放行。
#!category=去广告
#!date=2026-11-16
#!version=2026.11.16.1

[Rule]
URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com(?::80)?\/diagnose\?",REJECT,extended-matching

[Map Local]
(?i)^https:\/\/api\.m\.jd\.com(?::443)?\/client\.action\?(?:[^#?&]+&)*functionId=(searchBoxWord|stationPullService|uniformRecommend[06])(?:&|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
jd-adblock = type=http-response, pattern=(?i)^https:\/\/api\.m\.jd\.com(?::443)?\/client\.action(?:\?|$), script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/adblock/jd.js?v=a8c2ac0c50f1, requires-body=true, max-size=2097152,timeout=5

[MITM]
hostname = %APPEND% api.m.jd.com
