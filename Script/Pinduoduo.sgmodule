#!name=拼多多去广告
#!desc=移除开屏广告。
#!category=去广告
#!date=2026-11-16
#!version=2026.11.16.1

[Rule]
AND,((URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/d(\d)?",extended-matching),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
AND,((URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\]\/d(\d)?\?",extended-matching),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
AND,((DOMAIN,api.pinduoduo.com,extended-matching),(PROTOCOL,QUIC)),REJECT
DOMAIN,titan.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,xg.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,cdl-1.pddpic.com,REJECT,extended-matching,pre-matching
DOMAIN,cdl-p2.pddpic.com,REJECT,extended-matching,pre-matching
DOMAIN,cd-1.pddpic.com,REJECT,extended-matching,pre-matching
DOMAIN,apm.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,th-b.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,ta.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,th.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,th-a.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,ta-a.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,meta.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,apm-a.pinduoduo.com,REJECT,extended-matching,pre-matching

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com(?::443)?\/api\/alexa\/homepage\/hub\/?(?:\?[^#]*)?$ '(. as $original | try (delpaths([["result","dy_module","irregular_banner_dy"]])) catch $original) | (. as $original | try (delpaths([["result","icon_set"]])) catch $original) | (. as $original | try (delpaths([["result","search_bar_hot_query"]])) catch $original) | (. as $original | try (if (.result.bottom_tabs | type) == "array" then .result.bottom_tabs |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) else . end | if (.result.buffer_bottom_tabs | type) == "array" then .result.buffer_bottom_tabs |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) else . end | if (.result.all_top_opts | type) == "array" then .result.all_top_opts |= map(if type == "object" then del(.selected_image,.image,.height,.width) else . end) else . end) catch $original)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com(?::443)?\/search\/?(?:\?[^#]*)?$ '(. as $original | try (delpaths([["expansion"]])) catch $original)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com(?::443)?\/api\/philo\/personal\/hub\/?(?:\?[^#]*)?$ '(. as $original | try (delpaths([["monthly_card_entrance"]])) catch $original) | (. as $original | try (delpaths([["personal_center_style_v2_vo"]])) catch $original) | (. as $original | try (delpaths([["icon_set","icons"]])) catch $original) | (. as $original | try (delpaths([["icon_set","top_personal_icons"]])) catch $original) | (. as $original | try (delpaths([["personal_banner"]])) catch $original)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com(?::443)?\/api\/oak\/integration\/render\/?(?:\?[^#]*)?$ '(. as $original | try (delpaths([["bottom_section_list"]])) catch $original) | (. as $original | try (delpaths([["ui","bottom_section"]])) catch $original) | (. as $original | try (delpaths([["ui","live_section","float_info"]])) catch $original)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com(?::443)?\/api\/caterham\/v3\/query\/order_detail_group\/?(?:\?[^#]*)?$ '(. as $original | try (delpaths([["data","goods_list"]])) catch $original)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com(?::443)?\/order\/ '(. as $original | try (delpaths([["marketing_banner_vo"]])) catch $original) | (. as $original | try (delpaths([["shipping","banner_above_recommend"]])) catch $original)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com(?::443)?\/api\/aristotle\/order_list_v4\/?(?:\?[^#]*)?$ '(. as $original | try (.orders |= map(.order_buttons |= map(del(.order_growth_tip)))) catch $original)'

[Map Local]
