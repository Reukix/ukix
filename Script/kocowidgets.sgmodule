#!name=KocoWidgets
#!desc=KocoWidgets会员破解
#!date=2026-11-16
#!version=2026.11.16.1

[Script]
koco-request = type=http-request, pattern=^https:\/\/api\.(?:revenuecat|rc-backup)\.com(?::443)?\/v1\/(?:subscribers\/[^/?#]+\/?|receipts\/?)(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/kocowidgets.js?v=be5cdf827720, timeout=5
koco-response = type=http-response, pattern=^https:\/\/api\.(?:revenuecat|rc-backup)\.com(?::443)?\/v1\/(?:subscribers\/[^/?#]+\/?|receipts\/?)(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/kocowidgets.js?v=be5cdf827720, requires-body=true, max-size=2097152, timeout=5

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com
